{
  "name": "transitum",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma SaaS de logística e supply chain",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @transitum/api\" \"npm run dev -w @transitum/web\"",
    "dev:api": "npm run dev -w @transitum/api",
    "dev:web": "npm run dev -w @transitum/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate -w @transitum/api",
    "db:seed": "npm run db:seed -w @transitum/api"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "concurrently": "^9.1.2"
  },
  "optionalDependencies": {
    "@napi-rs/lzma-linux-x64-gnu": "1.5.1",
    "@rollup/rollup-linux-x64-gnu": "4.64.6",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "lightningcss-linux-x64-gnu": "1.32.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
