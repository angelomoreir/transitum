{
  "name": "blujay",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma SaaS de logística e supply chain",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @blujay/api\" \"npm run dev -w @blujay/web\"",
    "dev:api": "npm run dev -w @blujay/api",
    "dev:web": "npm run dev -w @blujay/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate -w @blujay/api",
    "db:seed": "npm run db:seed -w @blujay/api"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
