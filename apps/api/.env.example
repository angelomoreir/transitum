# Ambiente
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Base de dados — se vazio, usa PGlite local (PostgreSQL WASM) em PGLITE_DIR.
# Para Postgres real (docker-compose): postgres://transitum:transitum@localhost:5432/transitum
DATABASE_URL=
PGLITE_DIR=.data/pglite

# Auth — OBRIGATÓRIO alterar em produção (mín. 32 caracteres)
JWT_SECRET=dev-only-secret-change-me-0123456789
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
RESET_TOKEN_TTL_MINUTES=60

# Segurança
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# URL pública do frontend (links de convite/recuperação enviados por email)
WEB_BASE_URL=http://localhost:5173

# Armazenamento de documentos (driver local em disco; S3/MinIO em produção — TODO Fase 8)
STORAGE_DIR=.data/storage

# Emails de administradores da plataforma (separados por vírgula) — acesso a /api/admin
PLATFORM_ADMIN_EMAILS=

# Demonstração pública: protege as contas *@transitum.local (sem mudança de
# palavra-passe, MFA nem suspensão) para visitantes não trancarem a demo
DEMO_MODE=false

# Intervalo do scheduler (transições de subscrição, retries de webhooks)
SCHEDULER_INTERVAL_MS=3600000

# Storage S3/MinIO — se S3_BUCKET vazio, usa disco local (STORAGE_DIR)
# Em produção (docker-compose): S3_ENDPOINT=http://minio:9000
S3_ENDPOINT=
S3_REGION=eu-west-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Cifra de segredos na BD (credenciais AT e transportadoras) — OBRIGATÓRIO em produção
SECRETS_KEY=

# Geocodificação de moradas (mapas e distâncias) — "none" desativa
GEOCODER=nominatim
GEOCODER_URL=https://nominatim.openstreetmap.org
ROAD_DISTANCE_FACTOR=1.3

# Distâncias rodoviárias reais — "osrm" (router.project-osrm.org ou OSRM próprio)
# ou "none" (estimativa linha reta × fator). Resultados ficam em cache na BD.
ROUTER=osrm
ROUTER_URL=https://router.project-osrm.org

# Email para notificações ao destinatário — vazio regista na consola
SMTP_URL=
MAIL_FROM=Transitum <no-reply@transitum.local>

# SMS ao destinatário — "console" ou "twilio"
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Comunicação de documentos de transporte à AT (DL 198/2012)
# "mock" simula; "live" exige os certificados do produtor de software
AT_MODE=mock
AT_PUBLIC_KEY_PATH=
AT_CLIENT_PFX_PATH=
AT_CLIENT_PFX_PASSPHRASE=
AT_SIGNING_KEY_PATH=
AT_SIGNING_KEY_VERSION=1
AT_SOFTWARE_CERT_NUMBER=0
